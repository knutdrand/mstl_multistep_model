name: mstl_multistep_model

meta_data:
  author: Knut Rand
  author_note: >
    MSTL-decomposes each series in log1p space, fits a shared fixed-order ARIMA on the
    deseasonalized (trend + remainder) series for the mean and spread, and a pooled
    RandomForest that corrects the ARIMA residual using lagged climate anomalies, engineered
    IRS (indoor-residual-spraying) features and lagged self-history. A location-scale variance
    head widens the spread by the forest's own uncertainty. Seasonality is extrapolated
    seasonal-naive and added back before expm1.
  author_assessed_status: yellow
  contact_email: knutdrand@gmail.com
  description: >
    MSTL + fixed-order ARIMA + RandomForest-residual model for CHAP. Designed for small, noisy,
    highly-seasonal surveillance data with optional climate covariates and IRS campaign data.
  display_name: MSTL + ARIMA + RF residual
  organization: HISP Centre, University of Oslo
  citation_info: >
    Climate Health Analytics Platform. 2026. "MSTL + ARIMA + RF-residual Model".
    HISP Centre, University of Oslo.

# The model runs with or without covariates. Climate covariates and the IRS campaign columns are
# all supplied freely via additional_continuous_covariates (allow_free... = true) and are optional;
# IRS feature engineering is engaged by setting irs_column / irs_features below. Nothing is
# strictly required, so required_covariates is empty.
required_covariates: []
allow_free_additional_continuous_covariates: true
supported_period_type: any
target: disease_cases

user_options:
  target_variable:
    default: disease_cases
    title: Target column to forecast
    type: string
  treat_missing_as_zero:
    default: false
    title: Treat missing (NaN) target values as 0 reported cases instead of dropping them
    type: boolean
  season_length_monthly:
    default: 12
    title: MSTL season length for monthly data
    type: integer
  season_length_weekly:
    default: 52
    title: MSTL season length for weekly data
    type: integer
  feature_min_lag:
    default: 1
    title: Smallest covariate lag (periods)
    type: integer
  feature_max_lag:
    default: 3
    title: Largest covariate lag (periods)
    type: integer
  covariate_lags:
    default: {}
    title: "Per-covariate lag window override, {name: [min, max]}"
    type: object
  use_location_dummies:
    default: true
    title: Add one-hot location columns so the pooled model keeps per-series identity
    type: boolean
  rf_target_lags:
    default: 3
    title: Lagged deseasonalized-target values fed to the RF (future lags bridged with the ARIMA mean)
    type: integer
  arima_order:
    default: [0, 1, 2]
    title: Shared fixed ARIMA (p, d, q) order used for all locations
    type: array
    items: {type: integer}
  arima_level:
    default: 68
    title: Predictive-interval level used to read the ARIMA sigma
    type: integer
  irs_column:
    default: null
    title: Optional IRS allocation column (0-1 coverage); unset disables IRS feature engineering
    type: ["string", "null"]
  irs_features:
    default: []
    title: IRS features to engineer from the IRS columns (only used when irs_column is set)
    type: array
    items: {type: string}
  irs_halflife:
    default: 4.0
    title: Geometric decay half-life (months) for the plain IRS 'decay' feature
    type: number
  irs_chemical_column:
    default: null
    title: Optional insecticide column; enables the per-chemical decay channels (chem_channels)
    type: ["string", "null"]
  residual_variance:
    default: tree
    title: Location-scale variance head ('tree' widens spread by RF inter-tree variance; 'none' off)
    type: string
    enum: [none, tree]
  residual_variance_scale:
    default: 0.5
    title: Weight of the RF variance v(x) in sigma_eff^2 = sigma_ARIMA^2 + scale * v(x)
    type: number
  n_samples:
    default: 100
    title: Number of probabilistic sample paths
    type: integer
  random_seed:
    default: 42
    title: Random seed for sampling
    type: integer

uv_env: pyproject.toml

entry_points:
  train:
    parameters:
      train_data: str
      model: str
      model_config: str
    command: "python train.py {train_data} {model} --config {model_config}"
  predict:
    parameters:
      historic_data: str
      future_data: str
      model: str
      out_file: str
      model_config: str
    command: "python predict.py {model} {historic_data} {future_data} {out_file} --config {model_config}"
